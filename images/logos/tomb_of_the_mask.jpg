			body.fs-game #play_box.play_box{position:fixed!important;left:0!important;right:0!important;top:var(--vvo,0px)!important;width:100vw!important;height:var(--vvh,100vh)!important;z-index:999999!important;background:#000!important;display:flex!important;flex-direction:column!important;align-items:stretch!important;padding-bottom:var(--barTotal,0px)!important;box-sizing:border-box!important}
			body.fs-game #play_box .game-section-sample-bg,body.fs-game #play_box .game-section,body.fs-game #play_box .game-content,body.fs-game #play_box #game-player.game-iframe-container,body.fs-game #play_box .flash-container{width:100%!important;flex:1 1 auto!important;min-height:0!important;height:auto!important}
			body.fs-game #play_box iframe.game-iframe{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;border:0!important;z-index:1!important}
			body.fs-game #play_box .single-info-container{position:fixed!important;left:0!important;right:0!important;bottom:var(--vvb,0px)!important;z-index:1000000!important;padding-bottom:env(safe-area-inset-bottom)!important;margin:0!important;border-radius:0!important}
			body.fs-game #play_box .single-info-container{background:rgba(33,33,33,0.92)!important;backdrop-filter:blur(6px)}
			#viewFullscreen,#exitFullscreen{position:relative;z-index:1000002!important}
			body.fs-game #play_box .mb-3{margin-bottom:0!important}
			body.ad-showing #play_box.play_box{z-index:10!important}
			body.ad-showing #play_box .single-info-container{z-index:11!important}
			#play_box { position: relative; }
			#reward-loader.game-loader{position:absolute;inset:0;z-index:2147483646;display:grid;place-items:center;background:rgba(10,10,18,0.55);backdrop-filter:blur(10px);pointer-events:auto}
			#reward-loader.game-loader.is-hidden{display:none!important}
			#reward-loader.game-loader.is-viewport{position:fixed!important;inset:0!important}
			#reward-loader .glow-bg{position:absolute;inset:0;background:radial-gradient(circle at 50% 20%,rgba(120,70,255,.35),transparent 55%),radial-gradient(circle at 50% 70%,rgba(40,255,200,.25),transparent 60%);filter:blur(18px);opacity:.9}
			#reward-loader .loader-wrap{position:relative;width:min(520px,88vw);padding:18px 18px;border-radius:18px}
			#reward-loader .loader-bar{height:10px;border-radius:999px;overflow:hidden;background:rgba(255,255,255,0.12);box-shadow:inset 0 0 0 1px rgba(255,255,255,0.10)}
			#reward-loader .loader-fill{height:100%;width:0;border-radius:999px;background:#3bd671;transition:width .18s ease;box-shadow:0 0 18px rgba(255,255,255,.25)}
			#reward-loader .loader-text{margin-top:14px;text-align:center;color:rgba(255,255,255,.95);font-weight:700;font-size:18px}
		</style>
					<style>
		#cookieConsentBanner{
			position: fixed;
			bottom: 0;
			left: 0;
			width: 100%;
			background-color: #333;
			color: white;
			padding: 1em;
			display: flex;
			flex-wrap: wrap;
			justify-content: space-between;
			align-items: center;
			opacity: 0;
			transform: translateY(10px);
			pointer-events: none;
			transition: opacity .25s ease, transform .25s ease;
			z-index: 9999;
		}
		html.show-cookie-banner #cookieConsentBanner{
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
		}

		.cookie-consent-msg{
		text-align: left;
		flex: 1 1 auto;
		min-width: 200px;
		}

		.cookie-consent-actions{
		text-align: right;
		display: flex;
		gap: 10px;
		flex: 0 0 auto;
		}
		@media (max-width: 767px){
		#cookieConsentBanner{
			left: 0;
			right: 0;
			bottom: 0;
			max-width: none;
			border-radius: 0;
			padding: 14px;
			flex-direction: column;
			align-items: stretch;
		}
		.cookie-consent-msg,
		.cookie-consent-actions{
			width: 100%;
			text-align: center;
		}
		.cookie-consent-actions{
			justify-content: center;
		}
		}
	</style>
